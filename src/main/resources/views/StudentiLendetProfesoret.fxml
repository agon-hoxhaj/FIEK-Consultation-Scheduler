<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="350.0" prefWidth="410.0"
            style="-fx-background-color: #121212; -fx-padding: 5;"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.StudentiProfLendaController">
    <children>

        <TableView fx:id="tableView"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                   style="-fx-background-color: #1E1E1E;
                        -fx-background-radius: 10;
                        -fx-border-color: #2D2D2D;
                        -fx-border-radius: 10;
                        -fx-base: #1E1E1E;
                        -fx-control-inner-background: #1E1E1E;
                        -fx-control-inner-background-alt: #242424;
                        -fx-table-header-border-color: transparent;
                        -fx-table-cell-border-color: #2D2D2D;
                        -fx-accent: #FFB3B3;
                        -fx-focus-color: transparent;">

            <columns>
                <TableColumn fx:id="emriLendes"
                             prefWidth="150.0"
                             style="-fx-text-fill: #E0E0E0; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;"
                             text="%tblclmn.professorName" />

                <TableColumn fx:id="emriProfesorit"
                             prefWidth="250.0"
                             style="-fx-text-fill: #E0E0E0; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;"
                             text="%tblclmn.subjectName" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

        </TableView>
    </children>
</AnchorPane>