<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="650.0"
            style="-fx-background-color: #121212;"
            stylesheets="@../Styles/authStyle.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.SignInController">

    <top>
        <HBox alignment="CENTER" prefHeight="55.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleGoBack" text="%btn.back"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: #A0A0A0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#handleButtonGjuhaClick" text="%btn.gjuha"
                        style="-fx-background-color: transparent; -fx-text-fill: #FFB3B3; -fx-border-color: #FFB3B3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="460.0" spacing="12.0"
                      style="-fx-background-color: #1A1A1A; -fx-background-radius: 12; -fx-border-color: #2D2D2D; -fx-border-width: 1px; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 15, 0.0, 0.0, 4.0);">
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                    </padding>
                    <children>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="%lbl.user" textFill="#E0E0E0">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="Username" prefHeight="32.0"
                                           style="-fx-background-color: #242424; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-padding: 0 10 0 10;" />
                                <Label fx:id="errorUsernameLabel" style="-fx-text-fill: #FF6B6B;">
                                    <font>
                                        <Font name="System Italic" size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%lbl.password" textFill="#E0E0E0">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleForgotPass" text="%btn.forgotPass"
                                                style="-fx-background-color: transparent; -fx-text-fill: #FFB3B3; -fx-padding: 0; -fx-cursor: hand; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                    </children>
                                </HBox>
                                <PasswordField fx:id="Password" prefHeight="32.0"
                                               style="-fx-background-color: #242424; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6; -fx-padding: 0 10 0 10;" />
                                <Label fx:id="errorPasswordLabel" style="-fx-text-fill: #FF6B6B;">
                                    <font>
                                        <Font name="System Italic" size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label text="%lbl.chooseRole" textFill="#A0A0A0">
                                    <font>
                                        <Font name="System Italic" size="12.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <CheckBox fx:id="Student" minWidth="-Infinity" mnemonicParsing="false" text="%chckbx.student" textFill="WHITE" style="-fx-cursor: hand; -fx-selected-color: #FFB3B3;" />
                                        <CheckBox fx:id="Professor" minWidth="-Infinity" mnemonicParsing="false" text="%chckbx.professor" textFill="WHITE" style="-fx-cursor: hand; -fx-selected-color: #FFB3B3;" />
                                        <CheckBox fx:id="Admin" minWidth="-Infinity" mnemonicParsing="false" text="%chckbx.administrator" textFill="WHITE" style="-fx-cursor: hand; -fx-selected-color: #FFB3B3;" />
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="6.0" top="2.0" />
                            </VBox.margin>
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="36.0" prefWidth="240.0"
                                styleClass="pink-action-button" text="%btn.signIn">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Button>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>