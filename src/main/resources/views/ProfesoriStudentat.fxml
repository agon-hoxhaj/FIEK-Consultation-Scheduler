<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProfesoriStudentatController">
    <children>
        <VBox alignment="TOP_LEFT" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
            </padding>
            <children>

                <Label text="Studentët e profesorit" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <TableView fx:id="studentTable" stylesheets="@../Styles/tableStyle.css" style="-fx-background-color: #1A1A1A; -fx-border-color: #2D2D2D; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-background-radius: 8px;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="100.0" minWidth="60.0" prefWidth="80.0" style="-fx-alignment: CENTER;" text="ID" />
                        <TableColumn fx:id="colEmri" minWidth="120.0" prefWidth="-1.0" text="Emri" />
                        <TableColumn fx:id="colMbiemri" minWidth="120.0" prefWidth="-1.0" text="Mbiemri" />
                        <TableColumn fx:id="colEmail" minWidth="180.0" prefWidth="-1.0" text="Email" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>