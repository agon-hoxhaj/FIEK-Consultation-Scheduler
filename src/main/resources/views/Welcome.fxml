<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="400.0" prefWidth="600.0"
           style="-fx-background-color: #121212;"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.WelcomeController">
    <children>

        <Button mnemonicParsing="false" onAction="#handleButtonGjuhaClick" text="%btn.gjuha"
                style="-fx-background-color: transparent; -fx-text-fill: #FFB3B3; -fx-border-color: #FFB3B3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;"
                StackPane.alignment="TOP_RIGHT">
            <StackPane.margin>
                <Insets right="20.0" top="20.0" />
            </StackPane.margin>
            <font>
                <Font size="12.0" />
            </font>
        </Button>

        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="350.0" spacing="20.0"
              style="-fx-background-color: #1E1E1E; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0.0, 0.0, 8.0);"
              StackPane.alignment="CENTER">
            <padding>
                <Insets bottom="35.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

                <ImageView fitHeight="110.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/UniversitetiLogo.png" />
                    </image>
                </ImageView>

                <Label text="%txt.welcome" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Button mnemonicParsing="false" onAction="#handleSignIn" prefWidth="220.0"
                        style="-fx-background-color: #FFB3B3; -fx-text-fill: #121212; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="%btn.signIn">
                    <font>
                        <Font size="15.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="6.0">
                    <children>
                        <Label text="%txt.noAccount" textFill="#A0A0A0">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#handleRegister"
                                style="-fx-background-color: transparent; -fx-text-fill: #FFB3B3; -fx-padding: 0; -fx-underline: true; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="%btn.register">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>