<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_LEFT" prefHeight="500.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProfesoriTerminetContoller">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="5.0" />
    </padding>
    <children>

        <Label text="Terminet e Rezervuara" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <TableView fx:id="terminet" stylesheets="@../Styles/tableStyle.css" style="-fx-background-color: #1A1A1A; -fx-border-color: #2D2D2D; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-background-radius: 8px;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="koha" minWidth="120.0" prefWidth="-1.0" text="%txt.termini" />
                <TableColumn fx:id="lendatermini" minWidth="180.0" prefWidth="-1.0" text="%txt.lenda" />
                <TableColumn fx:id="st" minWidth="100.0" prefWidth="-1.0" text="%btn.studentat" />
                <TableColumn fx:id="arsyea" minWidth="180.0" prefWidth="-1.0" text="%txt.arsyeja" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>