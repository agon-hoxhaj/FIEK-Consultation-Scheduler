<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #121212;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RegisterProfesorController">

    <top>
        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleGoBack" text="%btn.back"
                        style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-border-color: #A0A0A0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#handleButtonGjuhaClick" text="%btn.gjuha"
                        style="-fx-background-color: transparent; -fx-text-fill: #FFB3B3; -fx-border-color: #FFB3B3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="480.0" spacing="15.0"
                      style="-fx-background-color: #1E1E1E; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0.0, 0.0, 8.0);">
                    <padding>
                        <Insets bottom="22.0" left="25.0" right="25.0" top="22.0" />
                    </padding>
                    <children>

                        <GridPane hgap="15.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="48.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="48.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>

                                <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="%lbl.name" textFill="#E0E0E0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="firstName" prefHeight="28.0"
                                                   style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="%lbl.surname" textFill="#E0E0E0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="lastName" prefHeight="28.0"
                                                   style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="%lbl.personalNum" textFill="#E0E0E0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="personalNumber" prefHeight="28.0"
                                                   style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="%lbl.email" textFill="#E0E0E0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="email" prefHeight="28.0"
                                                   style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6;" />
                                    </children>
                                </VBox>

                            </children>
                        </GridPane>

                        <VBox spacing="2.0">
                            <children>
                                <Label text="%lbl.telephone" textFill="#E0E0E0">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Label>
                                <TextField fx:id="phoneNumber" prefHeight="28.0"
                                           style="-fx-background-color: #2A2A2A; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #3A3A3A; -fx-border-radius: 6;" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label text="%lbl.gender" textFill="#A0A0A0">
                                    <font>
                                        <Font name="System Italic" size="12.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="25.0">
                                    <children>
                                        <CheckBox fx:id="female" minWidth="-Infinity" mnemonicParsing="false" text="%chckbx.female" textFill="WHITE" style="-fx-cursor: hand;" />
                                        <CheckBox fx:id="male" minWidth="-Infinity" mnemonicParsing="false" text="%chckbx.male" textFill="WHITE" style="-fx-cursor: hand;" />
                                    </children>
                                </HBox>
                                <Label fx:id="errorGenderLabel" style="-fx-text-fill: #FF6B6B;">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Button mnemonicParsing="false" onAction="#handleRegisterProfessor" prefHeight="35.0" prefWidth="220.0"
                                style="-fx-background-color: #FFB3B3; -fx-text-fill: #121212; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="%btn.register" />

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>